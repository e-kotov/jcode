From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Egor Kotov <kotov.egor@gmail.com>
Date: Fri, 25 Sep 2026 22:51:58 +0200
Subject: [PATCH] providers: no OPENAI_API_KEY fallback for MiniMax; no
 background catalog sweep

---
 crates/jcode-base/src/provider/catalog_scheduler.rs | 9 +++++++++
 crates/jcode-base/src/provider_catalog.rs           | 9 ++++++---
 crates/jcode-base/src/provider_catalog_tests.rs     | 5 +++--
 3 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/crates/jcode-base/src/provider/catalog_scheduler.rs b/crates/jcode-base/src/provider/catalog_scheduler.rs
index 03ca3b9a0..adfd1033c 100644
--- a/crates/jcode-base/src/provider/catalog_scheduler.rs
+++ b/crates/jcode-base/src/provider/catalog_scheduler.rs
@@ -34,6 +34,11 @@ const INITIAL_SWEEP_DELAY: Duration = Duration::from_secs(10);
 
 static SCHEDULER_STARTED: OnceLock<()> = OnceLock::new();
 
+/// e-kotov/jcode: no unprompted background `/models` probes of every provider
+/// whose key happens to be in the environment. The active provider still
+/// refreshes its own catalog.
+const BACKGROUND_SWEEP: bool = false;
+
 /// Invalidate every memoized route catalog in the process. Called when
 /// catalogs change out-of-band (refresh completion, auth changes), which is
 /// what keeps the route memo TTL a backstop rather than the mechanism.
@@ -47,6 +52,9 @@ pub fn bump_catalog_generation() {
 /// first successful start this is a single atomic load. It is a no-op when no
 /// tokio runtime is available, and will start on a later call once one is.
 pub(crate) fn ensure_started() {
+    if !BACKGROUND_SWEEP {
+        return;
+    }
     if SCHEDULER_STARTED.get().is_some() {
         return;
     }
@@ -140,6 +148,7 @@ mod tests {
     }
 
     #[tokio::test]
+    #[ignore = "e-kotov/jcode: the background sweep is disabled"]
     async fn ensure_started_is_idempotent_under_a_runtime() {
         ensure_started();
         // A second call must not spawn another sweeper.
diff --git a/crates/jcode-base/src/provider_catalog.rs b/crates/jcode-base/src/provider_catalog.rs
index ce80fbc7c..ebcfa06bf 100644
--- a/crates/jcode-base/src/provider_catalog.rs
+++ b/crates/jcode-base/src/provider_catalog.rs
@@ -24,6 +24,8 @@ pub fn api_base_uses_localhost(raw: &str) -> bool {
     )
 }
 
+const MINIMAX_FALLBACK_TO_OPENAI_API_KEY: bool = false;
+
 pub fn resolve_openai_compatible_profile(
     profile: OpenAiCompatibleProfile,
 ) -> ResolvedOpenAiCompatibleProfile {
@@ -46,9 +48,10 @@ pub fn resolve_openai_compatible_profile_with_api_key_hint(
     };
 
     // MiniMax historically used OPENAI_API_KEY because it exposes an
-    // OpenAI-compatible API. Prefer the dedicated key, but keep existing
-    // installations working when only the legacy binding is configured.
-    if profile.id == MINIMAX_PROFILE.id
+    // OpenAI-compatible API. e-kotov/jcode: never send OPENAI_API_KEY (often a
+    // different provider's key) to MiniMax; only MINIMAX_API_KEY counts.
+    if MINIMAX_FALLBACK_TO_OPENAI_API_KEY
+        && profile.id == MINIMAX_PROFILE.id
         && load_env_value_from_env_or_config(profile.api_key_env, profile.env_file).is_none()
         && load_env_value_from_env_or_config("OPENAI_API_KEY", profile.env_file).is_some()
     {
diff --git a/crates/jcode-base/src/provider_catalog_tests.rs b/crates/jcode-base/src/provider_catalog_tests.rs
index 99892905a..93f37540a 100644
--- a/crates/jcode-base/src/provider_catalog_tests.rs
+++ b/crates/jcode-base/src/provider_catalog_tests.rs
@@ -347,9 +347,10 @@ fn minimax_token_plan_keys_resolve_to_china_endpoint_without_changing_internatio
     assert_eq!(china.setup_url, MINIMAX_CHINA_SETUP_URL);
 
     crate::env::set_var("OPENAI_API_KEY", "sk-cp-legacy-token");
+    // e-kotov/jcode: OPENAI_API_KEY is never borrowed for MiniMax.
     let legacy = resolve_openai_compatible_profile(MINIMAX_PROFILE);
-    assert_eq!(legacy.api_key_env, "OPENAI_API_KEY");
-    assert_eq!(legacy.api_base, MINIMAX_CHINA_API_BASE);
+    assert_eq!(legacy.api_key_env, "MINIMAX_API_KEY");
+    assert!(!crate::provider_catalog::openai_compatible_profile_is_configured(MINIMAX_PROFILE));
 }
 
 #[test]
