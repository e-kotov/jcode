From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Egor Kotov <kotov.egor@gmail.com>
Date: Mon, 28 Sep 2026 17:28:42 +0200
Subject: [PATCH] telemetry: hardcode off

---
 crates/jcode-telemetry-core/src/lib.rs        | 22 ++++++++++++++++++-
 .../tests/session_creation_latency.rs         |  1 +
 .../src/tui/app/tests/onboarding_flow.rs      | 11 ++++------
 src/cli/telemetry.rs                          | 10 +--------
 4 files changed, 27 insertions(+), 17 deletions(-)

diff --git a/crates/jcode-telemetry-core/src/lib.rs b/crates/jcode-telemetry-core/src/lib.rs
index 4bdbb8670..da3cbcf13 100644
--- a/crates/jcode-telemetry-core/src/lib.rs
+++ b/crates/jcode-telemetry-core/src/lib.rs
@@ -461,7 +461,7 @@ pub fn opt_out_source() -> Option<TelemetryOptOutSource> {
 pub fn status() -> TelemetryStatus {
     let opt_out_source = opt_out_source();
     TelemetryStatus {
-        enabled: opt_out_source.is_none(),
+        enabled: cfg!(test) && opt_out_source.is_none(),
         content_sharing_enabled: content_sharing_enabled(),
         opt_out_source,
         telemetry_id: read_existing_id(),
@@ -469,6 +469,11 @@ pub fn status() -> TelemetryStatus {
 }
 
 pub fn is_enabled() -> bool {
+    // e-kotov/jcode: telemetry is hardcoded off in this build. Unit tests keep
+    // the upstream behaviour so the event-shaping logic stays covered.
+    if cfg!(not(test)) {
+        return false;
+    }
     match opt_out_source() {
         Some(TelemetryOptOutSource::Environment) => {
             logging::debug("telemetry disabled by environment");
@@ -545,6 +550,9 @@ pub fn set_usage_telemetry_enabled(enabled: bool) -> bool {
 }
 
 fn emit_telemetry_opt_out() {
+    if !is_enabled() {
+        return;
+    }
     let Some(id) = get_or_create_id() else {
         return;
     };
@@ -1302,6 +1310,9 @@ pub fn record_command_family(command: &str) {
 
 #[cfg(not(test))]
 fn post_payload(payload: serde_json::Value, timeout: Duration) -> bool {
+    if !is_enabled() {
+        return false;
+    }
     if TELEMETRY_PERMANENTLY_REJECTED.load(Ordering::Relaxed) {
         return false;
     }
@@ -1359,6 +1370,9 @@ fn post_payload_with_retry(payload: serde_json::Value, timeout: Duration) -> boo
 
 #[cfg(not(test))]
 fn post_transcript_payload(payload: serde_json::Value, timeout: Duration) -> bool {
+    if !is_enabled() {
+        return false;
+    }
     let client = TELEMETRY_HTTP_CLIENT.get_or_init(|| {
         reqwest::blocking::Client::builder()
             .user_agent(jcode_provider_core::JCODE_USER_AGENT)
@@ -1435,6 +1449,9 @@ fn send_transcript_payload(payload: Value) -> bool {
 
 #[cfg(not(test))]
 fn send_transcript_payload(payload: Value) -> bool {
+    if !is_enabled() {
+        return false;
+    }
     match transcript_background_sender().try_send(payload) {
         Ok(()) => true,
         Err(TrySendError::Full(_)) => {
@@ -1460,6 +1477,9 @@ fn send_payload(mut payload: serde_json::Value, mode: DeliveryMode) -> bool {
 
 #[cfg(not(test))]
 fn send_payload(mut payload: serde_json::Value, mode: DeliveryMode) -> bool {
+    if !is_enabled() {
+        return false;
+    }
     concurrency::mark_legacy_concurrency_unavailable(&mut payload);
     match mode {
         DeliveryMode::Background => {
diff --git a/crates/jcode-telemetry-core/tests/session_creation_latency.rs b/crates/jcode-telemetry-core/tests/session_creation_latency.rs
index 63f2b9733..0e636f68f 100644
--- a/crates/jcode-telemetry-core/tests/session_creation_latency.rs
+++ b/crates/jcode-telemetry-core/tests/session_creation_latency.rs
@@ -6,6 +6,7 @@ use std::process::Command;
 use std::time::{Duration, Instant};
 
 #[test]
+#[ignore = "e-kotov/jcode has no telemetry HTTP transport to exercise"]
 fn session_creation_does_not_wait_for_unreachable_telemetry() {
     const CHILD: &str = "JCODE_TEST_SESSION_LATENCY_CHILD";
     if std::env::var_os(CHILD).is_some() {
diff --git a/crates/jcode-tui/src/tui/app/tests/onboarding_flow.rs b/crates/jcode-tui/src/tui/app/tests/onboarding_flow.rs
index 239082739..baf28b935 100644
--- a/crates/jcode-tui/src/tui/app/tests/onboarding_flow.rs
+++ b/crates/jcode-tui/src/tui/app/tests/onboarding_flow.rs
@@ -1714,10 +1714,9 @@ fn telemetry_pill_opens_settings_page_and_commits_choice() {
 
         // Enter commits "Send everything": usage on, content sharing on.
         assert!(app.handle_onboarding_continue_prompt_key(KeyCode::Enter));
-        if !crate::telemetry::opt_out_forced_by_env() {
-            assert!(crate::telemetry::is_enabled());
-            assert!(crate::telemetry::content_sharing_enabled());
-        }
+        // e-kotov/jcode: usage telemetry stays off regardless of the choice.
+        assert!(!crate::telemetry::is_enabled());
+        assert!(!crate::telemetry::content_sharing_enabled());
         let no_telemetry_marker = std::path::Path::new(
             &std::env::var_os("JCODE_HOME").expect("temporary JCODE_HOME"),
         )
@@ -1766,9 +1765,7 @@ fn telemetry_page_send_nothing_disables_telemetry_and_esc_goes_back() {
             app.onboarding_phase(),
             Some(OnboardingPhase::Login { import: Some(_) })
         ));
-        if !crate::telemetry::opt_out_forced_by_env() {
-            assert!(crate::telemetry::is_enabled());
-        }
+        assert!(!crate::telemetry::is_enabled());
 
         // Reopen, walk down to "Send nothing", commit.
         assert!(app.handle_onboarding_continue_prompt_key(KeyCode::Char('t')));
diff --git a/src/cli/telemetry.rs b/src/cli/telemetry.rs
index e244d3c74..c5d295ad8 100644
--- a/src/cli/telemetry.rs
+++ b/src/cli/telemetry.rs
@@ -54,15 +54,7 @@ fn run_status(json: bool) -> Result<()> {
 }
 
 fn run_enable() -> Result<()> {
-    if !crate::telemetry::set_usage_telemetry_enabled(true) {
-        bail!("failed to persist telemetry setting");
-    }
-
-    if crate::telemetry::opt_out_forced_by_env() {
-        println!("Telemetry remains disabled because JCODE_NO_TELEMETRY or DO_NOT_TRACK is set.");
-    } else {
-        println!("Telemetry enabled.");
-    }
+    println!("Telemetry is permanently disabled in this build (e-kotov/jcode).");
     Ok(())
 }
 
