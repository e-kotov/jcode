diff --git a/crates/jcode-base/src/config/env_overrides.rs b/crates/jcode-base/src/config/env_overrides.rs
index 6b36ca7ee..51cca18c5 100644
--- a/crates/jcode-base/src/config/env_overrides.rs
+++ b/crates/jcode-base/src/config/env_overrides.rs
@@ -7,6 +7,10 @@ impl Config {
         reason = "Environment override parsing is intentionally explicit and grouped by config area"
     )]
     pub(crate) fn apply_env_overrides(&mut self) {
+        // e-kotov/jcode: integration discovery (`discover_tools`, api.jcode.sh)
+        // is hardcoded off, whatever the config file says.
+        self.sponsors.enabled = false;
+
         // Server/operator behavior
         if let Ok(v) = std::env::var("JCODE_WAKE_MODE")
             && let Some(parsed) = WakeMode::parse(&v)
